# Optional environment configuration for local development / deployment
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional SQLAlchemy persistence; leave blank to disable the archive
DATABASE_URL=

# Optional read-only Upstox market-data integration (Analytics Token)
UPSTOX_ANALYTICS_TOKEN=

# Optional OpenAI Agents SDK research workflow (keep the real key private)
OPENAI_API_KEY=
ARTHVEST_AGENT_MODEL=gpt-4.1-mini
