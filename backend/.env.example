# Optional environment configuration for local development / deployment
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional SQLAlchemy persistence; leave blank to disable the archive
DATABASE_URL=

# Optional read-only Upstox market data. Generate an Analytics Token in Upstox Developer Apps.
# This token is read-only and does not require an API key/client secret OAuth flow.
UPSTOX_ANALYTICS_TOKEN=

# Optional V3 WebSocket feed; this must be a separate OAuth access token.
# The read-only Analytics Token is not authorized for the V3 live feed.
UPSTOX_ACCESS_TOKEN=

# Market-data source: auto prefers Upstox when its token is set, otherwise Yahoo Finance.
MARKET_DATA_PROVIDER=auto
MARKET_DATA_CACHE_SECONDS=30
