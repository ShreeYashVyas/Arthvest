# Optional environment configuration for local development / deployment
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional SQLAlchemy persistence; leave blank to disable the archive
DATABASE_URL=

# Optional read-only Upstox market-data integration (Analytics Token)
UPSTOX_ANALYTICS_TOKEN=

# AI research workflow (local and free by default)
# Install Ollama, then run: ollama pull qwen2.5:7b
ARTHVEST_AGENT_PROVIDER=ollama
ARTHVEST_AGENT_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional hosted OpenAI provider (may incur API charges)
# Set ARTHVEST_AGENT_PROVIDER=openai and add your private API key only if desired.
OPENAI_API_KEY=
