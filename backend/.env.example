# Optional environment configuration for local development / deployment
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional SQLAlchemy persistence for macro archives, instrument catalogue, and market history.
# Leave blank to disable durable storage; Core will not silently use a temporary database.
DATABASE_URL=

# Optional read-only Upstox market data. Generate an Analytics Token in Upstox Developer Apps.
# This token is read-only and does not require an API key/client secret OAuth flow.
UPSTOX_ANALYTICS_TOKEN=

# Optional Token-API OAuth fallback for V3 WebSocket authorization.
# Core tries UPSTOX_ANALYTICS_TOKEN first; never commit either real token.
UPSTOX_ACCESS_TOKEN=

# Market-data source: auto prefers Upstox when its token is set, otherwise Yahoo Finance.
MARKET_DATA_PROVIDER=auto
MARKET_DATA_CACHE_SECONDS=30
