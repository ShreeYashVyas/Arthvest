# Optional environment configuration for local development / deployment
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional SQLAlchemy persistence; leave blank to disable the archive
DATABASE_URL=

# Optional read-only Upstox market-data integration (Analytics Token)
UPSTOX_ANALYTICS_TOKEN=

# Free local AI inference via Ollama (default; no OpenAI API key required)
ARTHVEST_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
ARTHVEST_AGENT_MODEL=qwen3:4b
# Local inference is capped at three simultaneous specialist runs by default.
ARTHVEST_AGENT_MAX_CONCURRENCY=3

# Optional paid cloud mode instead:
# ARTHVEST_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ARTHVEST_AGENT_MODEL=gpt-4.1-mini
